<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/gradient_header"
        android:gravity="center_vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/btnMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☰"
            android:textSize="24sp"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Receipts"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Camera capture card -->
            <LinearLayout
                android:id="@+id/topCardContainer"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/card_gradient_background"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@android:drawable/ic_menu_camera"
                    android:contentDescription="@string/receipt_preview"
                    app:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scan or Capture Receipt"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnGallery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Upload From Gallery"
                android:textColor="#FFFFFF"
                android:background="@drawable/card_gradient_background"
                app:backgroundTint="@null"/>

            <!-- Most recent receipt preview (shown after capture/upload) -->
            <ImageView
                android:id="@+id/ivReceiptPreview"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="@string/recent_receipt"
                android:layout_marginTop="16dp"/>

            <!-- Filter: Category -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Filter by Category"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp"/>

            <Spinner
                android:id="@+id/spFilterCategory"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/card_background"
                android:layout_marginBottom="12dp"/>

            <!-- Filter: Date -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Filter by Date"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etFilterDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Select date (or leave blank for all)"
                android:focusable="true"
                android:clickable="true"
                android:inputType="none"
                android:background="@drawable/card_background"
                android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                android:padding="12dp"
                android:layout_marginBottom="4dp"/>

            <!-- Clear date filter -->
            <Button
                android:id="@+id/btnClearDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clear Date"
                android:textColor="#FFFFFF"
                android:backgroundTint="#9E9E9E"
                android:layout_marginBottom="12dp"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>

            <!-- Filter: Description search -->
            <EditText
                android:id="@+id/etSearchReceipts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Search by description"
                android:padding="14dp"
                android:background="@drawable/card_background"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="10dp"
                android:layout_marginBottom="20dp"
                android:textSize="14sp"/>

            <!-- All receipts list -->
            <LinearLayout
                android:id="@+id/recentReceiptsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

